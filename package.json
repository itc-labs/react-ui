        "import": "./dist/i18n/index.js"
      },
      "./i18n/react": {
        "types": "./dist/i18n/provider.d.ts",
        "import": "./dist/i18n/provider.js"
      },
      "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "import": "./dist/hooks/index.js"
      },
      "./icons/custom": {
        "types": "./dist/components/icon/custom/index.d.ts",
        "import": "./dist/components/icon/custom/index.js"
      },
      "./illustrations": {
        "types": "./dist/components/illustration/index.d.ts",
        "import": "./dist/components/illustration/index.js"
      },
      "./illustrations/*": {
        "types": "./dist/components/illustration/*.d.ts",
        "import": "./dist/components/illustration/*.js"
      },
      "./icons/outline": {
        "types": "./dist/components/icon/outline/index.d.ts",
        "import": "./dist/components/icon/outline/index.js"
      },
      "./icons/outline/*": {
        "types": "./dist/components/icon/outline/*.d.ts",
        "import": "./dist/components/icon/outline/*.js"
      },
      "./icons/bold": {
        "types": "./dist/components/icon/bold/index.d.ts",
        "import": "./dist/components/icon/bold/index.js"
      },
      "./icons/bold/*": {
        "types": "./dist/components/icon/bold/*.d.ts",
        "import": "./dist/components/icon/bold/*.js"
      },
      "./icons/catalog": {
        "types": "./dist/components/icon/catalog.d.ts",
        "import": "./dist/components/icon/catalog.js"
      },
      "./modal": {
        "types": "./dist/components/modal/client.d.ts",
        "import": "./dist/components/modal/client.js"
      },
      "./toast": {
        "types": "./dist/components/toast/client.d.ts",
        "import": "./dist/components/toast/client.js"
      },
      "./theme/styles.css": "./dist/theme/styles.css",
      "./theme/fonts.css": "./dist/theme/fonts.css",
      "./theme/base.css": "./dist/theme/base.css",
      "./theme/vendor.css": "./dist/theme/vendor.css",
      "./theme/motion.css": "./dist/theme/motion.css",
      "./theme/fonts-800.css": "./dist/theme/fonts-800.css",
      "./editor": {
        "types": "./dist/modules/editor/index.d.ts",
        "import": "./dist/modules/editor/index.js"
      },
      "./chart": {
        "types": "./dist/modules/chart/index.d.ts",
        "import": "./dist/modules/chart/index.js"
      },
      "./avatar-upload": {
        "types": "./dist/modules/avatar-upload/index.d.ts",
        "import": "./dist/modules/avatar-upload/index.js"
      },
      "./ui.css": "./dist/ui.css"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "src/components/icon/licenses"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
